{
  "name": "vuexpresspro-backend",
  "version": "1.0.0",
  "main": "server.js",
  "scripts": {
    "dev": "cross-env NODE_ENV=development nodemon server.js",
    "build": "npm run clean && ncc build server.js -o dist -m -a && npm run copy-env",
    "preview": "npm run build && cross-env NODE_ENV=development node dist",
    "deploy": "npm run build && npm run start",
    "start": "cross-env NODE_ENV=production node dist",
    "clean": "shx rm -rf dist",
    "format": "prettier --write .",
    "copy-env": "shx cp .env.production .env.development dist"
  },
  "author": "LoveDoLove",
  "license": "MIT",
  "keywords": [],
  "description": "",
  "dependencies": {
    "@types/express": "^5.0.3",
    "axios": "^1.10.0",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dotenv": "^17.2.0",
    "express": "^5.1.0",
    "multer": "^2.0.2",
    "mysql": "^2.18.1",
    "nodemailer": "^7.0.5",
    "nodemon": "^3.1.10",
    "pino": "^9.7.0",
    "pino-http": "^10.5.0",
    "pino-pretty": "^13.0.0",
    "prettier": "^3.6.2",
    "sharp": "^0.34.3"
  },
  "devDependencies": {
    "@vercel/ncc": "^0.38.3",
    "cross-env": "^7.0.3",
    "shx": "^0.4.0"
  }
}
